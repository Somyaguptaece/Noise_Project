# Environment configuration for Noise Resolve AI Server
PORT=5000
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# AI Provider Configuration: "mock" (default, no API key needed), "gemini", or "openai"
AI_PROVIDER=mock

# Real AI Keys (optional - leave blank to use deterministic mock engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
